{
  "manifest_version": 3,
  "name": "PromptPort - AI Context & Prompt Transfer",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "offline_enabled": true,
  "description": "Port your prompts and conversation history to any AI in one click. 100% local context transfer across ChatGPT, Claude, Gemini, DeepSeek, and more.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.openai.com/*",
    "*://chatgpt.com/*",
    "*://*.gemini.google.com/*",
    "*://*.claude.ai/*",
    "*://*.kimi.moonshot.cn/*",
    "*://*.kimi.ai/*",
    "*://*.grok.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.chat.deepseek.com/*",
    "*://*.deepseek.com/*",
    "*://*.chatglm.cn/*",
    "*://*.z.ai/*",
    "*://z.ai/*",
    "*://*.bigmodel.cn/*",
    "*://*.internlm.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "action": {
    "default_title": "Open PromptPort",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.openai.com/*",
        "*://chatgpt.com/*",
        "*://*.gemini.google.com/*",
        "*://*.claude.ai/*",
        "*://*.kimi.moonshot.cn/*",
        "*://*.kimi.ai/*",
        "*://*.grok.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.chat.deepseek.com/*",
        "*://*.deepseek.com/*",
        "*://*.chatglm.cn/*",
        "*://*.z.ai/*",
        "*://z.ai/*",
        "*://*.bigmodel.cn/*",
        "*://*.internlm.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
